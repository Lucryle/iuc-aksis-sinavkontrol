# Aksis girisi: tarayicida bir kez giris yap (Google ile olabilir), sonra
# F12 > Application > Cookies > https://teknokta.iuc.edu.tr altindaki
# "idsrv" cookie'sinin degerini buraya yapistir.
# Birden fazla cookie gerekiyorsa: IDS_COOKIE=idsrv=...; idsrv.session=...
IDS_COOKIE=

# Oturum dusunce tarayiciyla otomatik yeniden giris (OTURUM_YENILEME=tarayici | mail)
# Tampermonkey'e aksis_otomatik_giris.user.js kurulu olmali; Cloudflare tikini sen isaretlersin.
OTURUM_YENILEME=tarayici
AKSIS_USERNAME=
AKSIS_PASSWORD=
# Chrome farkli bir yerdeyse: CHROME_PATH=C:\...\chrome.exe

# Gmail (EMAIL_PASSWORD = gonderen hesabin uygulama sifresi, normal sifre degil)
EMAIL_ADDRESS=
EMAIL_PASSWORD=
# Birden fazla alici icin virgulle ayir
EMAIL_TO_LIST=

# Donem: YIL=2026 DONEM=1 -> 2026-2027 Guz, DONEM=2 -> Bahar
YIL=2026
DONEM=1

# Opsiyonel
CHECK_INTERVAL=30
VERIFY_SSL=false

# Hocalardan gelen mesajlari da takip et (true/false)
CHECK_MESSAGES=true
# Dokuman Paylasimi takibi (true/false)
CHECK_DOCUMENTS=true
